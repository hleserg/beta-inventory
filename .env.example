# Copy to .env and edit. Every setting lives here; the code only holds defaults.
# After a change: docker compose up -d

# Port on the host.
PORT=8000

# Address printed into labels (QR and the NFC link).
# A name (http://inv.lan) survives the server moving to another IP, but needs a
# DNS record in your router. An IP (http://192.168.1.51) works without DNS, but
# every printed label is tied to that IP. Empty: the address you opened the site by.
# Pick once before printing labels: printed QR codes can't be changed.
PUBLIC_BASE_URL=

# Time zone for the history, POSIX form: MSK-3 is Moscow.
TZ=UTC

# Label image size for the label printer.
LABEL_W_MM=25
LABEL_H_MM=15
LABEL_DPI=300

# Photos are shrunk on upload to this long side (px) and saved as JPEG of this quality.
# 2560 and 90 keep small print on a photo readable; a phone shot drops from 5-10 MB to ~1 MB.
PHOTO_MAX_PX=2560
PHOTO_QUALITY=90

# Deleted things, boxes and places wait in «Корзина» this many days for «Вернуть», then go for good.
TRASH_DAYS=30

# Search by meaning: local model (fastembed). Empty turns it off.
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# How close in meaning an item must be to show up (0..1).
SEMANTIC_MIN=0.35
# Show only matches this close to the best one.
SEMANTIC_MARGIN=0.08
# At most this many matches by meaning.
SEMANTIC_TOP=5

# Profile with card fields. Empty: data/profile.yaml, else profiles/default.yaml.
PROFILE=

# Package mirror for the build, if PyPI is slow: https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple
