# Copy to .env and edit. Every setting lives here; the code only holds defaults.
# After a change: docker compose up -d
# Most of them can also be changed on the site, «Ещё» → «Настройки» (/settings); a value saved
# there (data/settings.json) beats this file until «Сбросить» on the site.

# Port on the host.
PORT=8000

# Address printed into labels (QR and the NFC link).
# A name (http://inv.lan) survives the server moving to another IP, but needs a
# DNS record in your router. An IP (http://192.168.1.51) works without DNS, but
# every printed label is tied to that IP. Empty: the address you opened the site by.
# Pick once before printing labels: printed QR codes can't be changed.
PUBLIC_BASE_URL=

# Scanning labels. NFC tags (Chrome on Android), the QR scanner on the site; 0 hides it from the site
# (a QR printed on a label still opens with the phone camera). Corner button: auto = NFC where the
# phone reads tags, else QR; nfc or qr = that one first.
SCAN_NFC=1
SCAN_QR=1
SCAN_DEFAULT=auto

# Time zone for the history, POSIX form: MSK-3 is Moscow.
TZ=UTC

# Label image size for the label printer.
LABEL_W_MM=25
LABEL_H_MM=15
LABEL_DPI=300

# «Печать» on a Niimbot over Bluetooth (Chrome; PRINT_BT=0 hides the button): the label size comes from the roll when the printer tells it,
# else from LABEL_W_MM x LABEL_H_MM. Turn the picture (0/90/180/270), shift it (mm, -5..5), darkness 1-5.
PRINT_BT=1
PRINT_ROTATE=0
PRINT_DX_MM=0
PRINT_DY_MM=0
PRINT_DENSITY=3

# Photos are shrunk on upload to this long side (px) and saved as JPEG of this quality.
# 2560 and 90 keep small print on a photo readable; a phone shot drops from 5-10 MB to ~1 MB.
PHOTO_MAX_PX=2560
PHOTO_QUALITY=90

# Deleted things, boxes and places wait in «Корзина» this many days for «Вернуть», then go for good.
TRASH_DAYS=30

# A portable NFC reader (/readers) forgets its box after this many minutes without a tap,
# so tomorrow's pliers don't land in yesterday's box. Stationary readers never forget.
READER_FORGET_MIN=10

# Search by meaning: local model (fastembed). Empty turns it off.
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# How close in meaning an item must be to show up (0..1).
SEMANTIC_MIN=0.35
# Show only matches this close to the best one.
SEMANTIC_MARGIN=0.08
# At most this many matches by meaning.
SEMANTIC_TOP=5

# GitHub account whose new repos show up under «Новые из GitHub» on /projects. Empty: no sync. Forks are skipped.
GITHUB_OWNER=
# Optional token to see private repos too: fine-grained, read-only, "Metadata" access is enough.
GITHUB_TOKEN=
# How often to look for new repos, in minutes.
GITHUB_SYNC_MIN=60

# Profile with card fields. Empty: data/profile.yaml, else profiles/default.yaml.
PROFILE=

# Package mirror for the build, if PyPI is slow: https://mirrors.aliyun.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple
